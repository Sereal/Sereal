diff --git a/Perl/Encoder/t/140_sorted_callback_cursor.t b/Perl/Encoder/t/140_sorted_callback_cursor.t
new file mode 100644
index 00000000..1531d4b7
--- /dev/null
+++ b/Perl/Encoder/t/140_sorted_callback_cursor.t
@@ -0,0 +1,59 @@
+#!perl
+use strict;
+use warnings;
+use File::Spec;
+use Test::More;
+use lib File::Spec->catdir(qw(t lib));
+BEGIN { lib->import('lib') if !-d 't' }
+use Sereal::TestSet qw(have_encoder_and_decoder);
+use Sereal::Encoder;
+plan skip_all => 'decoder unavailable' unless have_encoder_and_decoder();
+
+our $callback;
+{
+    package SerealSortedCursorFreeze;
+    sub FREEZE { $main::callback->($_[0]{key}); return $_[0]{key} }
+    sub THAW { bless {key => $_[2]}, $_[0] }
+}
+
+for my $version (2 .. 6) {
+    for my $sort (1 .. 3) {
+        my $encoder = Sereal::Encoder->new({
+            protocol_version => $version, sort_keys => $sort, freeze_callbacks => 1,
+        });
+        for my $mutation (qw(none replace_value delete_future replace_future delete_current)) {
+            my %input = map { my $key = sprintf 'key-%02d', $_;
+                ($key => bless({key => $key}, 'SerealSortedCursorFreeze')) } 1 .. 20;
+            my $ran = 0;
+            my $victim;
+            local $callback = sub {
+                my ($current) = @_;
+                return if $ran++;
+                ($victim) = grep { $_ ne $current } sort keys %input;
+                if ($mutation eq 'replace_value') { $input{$victim} = 'new value' }
+                elsif ($mutation eq 'delete_future') { delete $input{$victim} }
+                elsif ($mutation eq 'replace_future') {
+                    delete $input{$victim};
+                    $input{'replacement'} = 'replacement';
+                }
+                elsif ($mutation eq 'delete_current') {
+                    delete $input{$current};
+                    $input{'replacement'} = 'replacement';
+                }
+            };
+            my $packet = eval { $encoder->encode(\%input) };
+            my $error = $@;
+            my $label = "v$version sort=$sort $mutation";
+            if ($mutation eq 'none' || $mutation eq 'replace_value') {
+                is($error, '', "$label encodes");
+                my $decoded = eval { Sereal::Decoder->new->decode($packet) };
+                is_deeply($decoded, \%input, "$label reads values at use without snapshots");
+            } else {
+                like($error, qr/input hash was modified during encoding/, "$label rejects stale iteration state");
+            }
+            is_deeply(Sereal::Decoder->new->decode($encoder->encode([7])), [7],
+                "$label encoder remains reusable");
+        }
+    }
+}
+done_testing;
diff --git a/Perl/Encoder/t/141_predicate_callback_lifetime.t b/Perl/Encoder/t/141_predicate_callback_lifetime.t
new file mode 100644
index 00000000..f7708322
--- /dev/null
+++ b/Perl/Encoder/t/141_predicate_callback_lifetime.t
@@ -0,0 +1,73 @@
+#!perl
+use strict;
+use warnings;
+use File::Spec;
+use Test::More;
+use lib File::Spec->catdir(qw(t lib));
+BEGIN { lib->import('lib') if !-d 't' }
+use Sereal::TestSet qw(have_encoder_and_decoder);
+use Sereal::Encoder;
+plan skip_all => 'decoder unavailable' unless have_encoder_and_decoder();
+
+our ($freezes, $destroys, $truths, @input);
+{
+    package SerealPredicateObject;
+    sub FREEZE { ++$main::freezes; return 'kept alive' }
+    sub THAW { bless {value => $_[2]}, $_[0] }
+    sub DESTROY { ++$main::destroys }
+
+    package SerealPredicateTruth;
+    use overload bool => sub { ++$main::truths; $_[0]->() }, fallback => 1;
+
+}
+
+for my $version (2 .. 6) {
+    for my $action (qw(allow serialize croak)) {
+        ($freezes, $destroys) = (0, 0);
+        my $object = bless {value => 'kept alive'}, 'SerealPredicateObject';
+        my $encoder = Sereal::Encoder->new({
+            protocol_version => $version,
+            freeze_allow_classes => sub { undef $object; undef $_[1]; return $action eq 'allow' },
+            freeze_deny_action => $action eq 'serialize' ? 'serialize' : 'croak',
+        });
+        my $packet = eval { $encoder->encode($object) };
+        my $error = $@;
+        my $label = "v$version predicate overwrites argument $action";
+        ok(!defined $object, "$label changes the original reference");
+        is($destroys, 1, "$label releases the original referent once");
+        is($freezes, $action eq 'allow' ? 1 : 0, "$label follows the decision");
+        if ($action eq 'croak') {
+            like($error, qr/FREEZE not allowed for class 'SerealPredicateObject'/, "$label throws");
+        } else {
+            is($error, '', "$label encodes");
+            my $decoded = Sereal::Decoder->new->decode($packet);
+            is($decoded->{value}, 'kept alive', "$label retains the referent through use");
+        }
+        is_deeply(Sereal::Decoder->new->decode($encoder->encode([7])), [7], "$label encoder remains reusable");
+    }
+
+    for my $action (qw(clear throw)) {
+        ($freezes, $truths) = (0, 0);
+        @input = (bless({value => 'first'}, 'SerealPredicateObject'), 'second', 'third');
+        my $encoder = Sereal::Encoder->new({
+            protocol_version => $version,
+            freeze_allow_classes => sub {
+                return bless sub {
+                    die "predicate truth failure\n" if $action eq 'throw';
+                    undef @input;
+                    return 1;
+                }, 'SerealPredicateTruth';
+            },
+        });
+        eval { $encoder->encode(\@input) };
+        my $error = $@;
+        my $label = "v$version overloaded predicate truth $action";
+        like($error, $action eq 'throw' ? qr/predicate truth failure/ : qr/input array was modified during encoding/,
+            "$label throws before stale state is used");
+        is($truths, 1, "$label converts the result once");
+        is($freezes, 0, "$label never calls FREEZE");
+        is_deeply(Sereal::Decoder->new->decode($encoder->encode([7])), [7], "$label encoder remains reusable");
+        @input = ();
+    }
+}
+done_testing;
diff --git a/Perl/Encoder/t/142_cached_integer_values.t b/Perl/Encoder/t/142_cached_integer_values.t
new file mode 100644
index 00000000..7b699ef4
--- /dev/null
+++ b/Perl/Encoder/t/142_cached_integer_values.t
@@ -0,0 +1,44 @@
+#!perl
+use strict;
+use warnings;
+use File::Spec;
+use Scalar::Util qw(dualvar refaddr);
+use Test::More;
+use lib File::Spec->catdir(qw(t lib));
+BEGIN { lib->import('lib') if !-d 't' }
+use Sereal::TestSet qw(have_encoder_and_decoder);
+use Sereal::Encoder;
+plan skip_all => 'decoder unavailable' unless have_encoder_and_decoder();
+{
+    package SerealCachedIntegerFetch;
+    sub TIESCALAR { bless {value => $_[1], count => 0}, $_[0] }
+    sub FETCH { ++$_[0]{count}; $_[0]{value} }
+}
+my $uvmax = ~0;
+my $ivmax = $uvmax >> 1;
+my $ivmin = -$ivmax - 1;
+my @values = (0, 1, 15, 16, 127, 128, 255, 256, 16383, 16384,
+    65535, 65536, 2147483647, $ivmax, $uvmax, -1, -16, -17, $ivmin);
+for my $version (1 .. 6) {
+    my $encoder = Sereal::Encoder->new({protocol_version => $version});
+    for my $value (@values) {
+        my $label = "v$version integer=$value";
+        my $shared = $value;
+        my $data = [$value, \$shared, \$shared];
+        my $packet = $encoder->encode($data);
+        my $decoded = Sereal::Decoder->new->decode($packet);
+        is_deeply($decoded, $data, "$label direct and referenced values round trip");
+        is(refaddr($decoded->[1]), refaddr($decoded->[2]), "$label preserves shared references");
+        is($encoder->encode($data), $packet, "$label has stable output on Encoder reuse");
+
+        my @magic = (undef);
+        my $tie = tie $magic[0], 'SerealCachedIntegerFetch', $value;
+        is_deeply(Sereal::Decoder->new->decode($encoder->encode(\@magic)), [$value],
+            "$label encodes the fetched integer");
+        is($tie->{count}, 1, "$label FETCHes once");
+    }
+    my $dual = dualvar(37, 'use the string');
+    is($encoder->encode([$dual]), $encoder->encode(['use the string']),
+        "v$version cached numeric value does not override a dualvar string");
+}
+done_testing;
