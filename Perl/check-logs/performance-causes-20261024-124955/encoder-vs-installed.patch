+SRL_STATIC_INLINE void
+srl_getmagic(pTHX_ srl_encoder_t *enc, SV *value, SV *reference)
+{
+    if (SvGMAGICAL(value)) {
+        srl_callback_begin(aTHX_ enc, value, reference);
+        SvGETMAGIC(value);
+        srl_callback_end(aTHX_ enc);
+    }
+}
